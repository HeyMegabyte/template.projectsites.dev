{
  "$schema": "https://schemas.designtokens.org/2025-10",
  "$description": "Retail / e-commerce / outdoor-goods preset — DARK, bold & rugged charcoal-slate with a high-energy safety-orange accent. Trailhead 'gear-shop' mood: sharp radii, hard high-contrast shadows, condensed Oswald headings over Inter. Outfitters, hardware, gear stores map here.",

  "business": {
    "name":          { "$value": "Field Threads" },
    "shortName":     { "$value": "Field" },
    "tagline":       { "$value": "Built for the backcountry" },
    "description":   { "$value": "Independent outdoor outfitter. Trail-tested packs, layers, and hardware, designed for the backcountry and backed by a lifetime repair guarantee." },
    "url":           { "$value": "https://fieldthreads.example" },
    "businessClass": { "$value": "retail" },
    "email":         { "$value": "hello@fieldthreads.example" },
    "phone":         { "$value": "" },
    "address":       { "$value": "Bozeman, MT" },
    "hours":         { "$value": "" }
  },

  "color": {
    "brandHue":    { "$value": "150" },
    "brandChroma": { "$value": "0.06" },
    "primary":     { "$value": "oklch(0.60 0.10 150)" },
    "primaryHover":{ "$value": "oklch(0.54 0.10 150)" },
    "accent":      { "$value": "oklch(0.74 0.19 55)" },
    "accentHover": { "$value": "oklch(0.68 0.20 52)" },
    "background":  { "$value": "oklch(0.19 0.015 160)" },
    "surface":     { "$value": "oklch(0.24 0.018 160)" },
    "surfaceElevated":{ "$value": "oklch(0.29 0.02 160)" },
    "border":      { "$value": "oklch(0.38 0.02 160)" },
    "text":        { "$value": "oklch(0.96 0.008 90)" },
    "textMuted":   { "$value": "oklch(0.76 0.015 90)" },
    "textSubtle":  { "$value": "oklch(0.60 0.012 90)" },
    "success":     { "$value": "oklch(0.72 0.17 150)" },
    "warning":     { "$value": "oklch(0.80 0.16 80)" },
    "danger":      { "$value": "oklch(0.64 0.22 28)" },
    "info":        { "$value": "oklch(0.70 0.13 220)" }
  },

  "colorScheme": { "$value": "dark" },

  "themeStyle":  { "$value": "boutique", "$type": "string", "$description": "Visual personality preset (font/radius/shadow/motion + flourish). See template src/themePresets.ts." },


  "font": {
    "heading":   { "$value": "Oswald" },
    "body":      { "$value": "Inter" },
    "mono":      { "$value": "JetBrains Mono" },
    "weights":   { "$value": [400,500,600,700] },
    "fluidScale":{ "$value": "clamp" }
  },

  "radius":  { "sm": { "$value": "0.125rem" }, "md": { "$value": "0.25rem" }, "lg": { "$value": "0.375rem" }, "xl": { "$value": "0.5rem" }, "2xl": { "$value": "0.75rem" }, "full": { "$value": "9999px" } },
  "spacing": { "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }, "32": { "$value": "8rem" } },
  "shadow":  { "sm": { "$value": "0 1px 0 0 oklch(0 0 0 / 0.40)" }, "md": { "$value": "0 8px 20px -6px oklch(0 0 0 / 0.55), 0 2px 4px -2px oklch(0 0 0 / 0.40)" }, "lg": { "$value": "0 20px 44px -10px oklch(0 0 0 / 0.65), 0 4px 10px -4px oklch(0 0 0 / 0.50)" }, "glow": { "$value": "0 0 44px -8px oklch(0.74 0.19 55 / 0.60)" } },
  "motion":  { "easing": { "$value": "cubic-bezier(0.2, 0.9, 0.3, 1)" }, "duration": { "fast": { "$value": "120ms" }, "base": { "$value": "220ms" }, "slow": { "$value": "400ms" }, "scroll": { "$value": "1100ms" } } },
  "layout":  { "containerWide": { "$value": "82rem" }, "containerNormal": { "$value": "64rem" }, "containerProse": { "$value": "42rem" } },
  "social":  { "facebook": { "$value": "" }, "instagram": { "$value": "" }, "linkedin": { "$value": "" }, "twitter": { "$value": "" }, "youtube": { "$value": "" }, "tiktok": { "$value": "" }, "github": { "$value": "" } },

  "features": {
    "hero":         { "$value": true },
    "bento":        { "$value": true },
    "stats":        { "$value": true },
    "services":     { "$value": false },
    "process":      { "$value": false },
    "testimonials": { "$value": true },
    "logoCloud":    { "$value": true },
    "pricing":      { "$value": false },
    "faq":          { "$value": true },
    "blog":         { "$value": true },
    "team":         { "$value": false },
    "caseStudies":  { "$value": false },
    "newsletter":   { "$value": true },
    "cta":          { "$value": true }
  }
}
