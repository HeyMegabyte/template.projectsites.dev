{
  "$schema": "https://schemas.designtokens.org/2025-10",
  "$description": "Nonprofit / NGO / charity preset — LIGHT, hopeful forest-green on warm paper with a friendly coral accent. Community 'dignified & warm' mood: soft generous radii, warm layered shadows, humanist Crimson Pro serif over Inter. stats + caseStudies + newsletter + donate CTA.",

  "business": {
    "name":          { "$value": "Anchorage Weekend Bags" },
    "shortName":     { "$value": "AWB" },
    "tagline":       { "$value": "Feeding kids on the weekend" },
    "description":   { "$value": "A 501(c)(3) packing 1,200 weekend food bags every Friday for Anchorage School District kids who would otherwise go hungry. EIN 12-3456789." },
    "url":           { "$value": "https://anchorageweekendbags.example" },
    "businessClass": { "$value": "nonprofit" },
    "email":         { "$value": "hello@anchorageweekendbags.example" },
    "phone":         { "$value": "+19075550100" },
    "address":       { "$value": "1234 4th Avenue, Anchorage, AK 99501" },
    "hours":         { "$value": "Pack Fri 1–5pm" }
  },

  "color": {
    "brandHue":    { "$value": "150" },
    "brandChroma": { "$value": "0.13" },
    "primary":     { "$value": "oklch(0.47 0.13 150)" },
    "primaryHover":{ "$value": "oklch(0.40 0.13 150)" },
    "accent":      { "$value": "oklch(0.78 0.15 35)" },
    "accentHover": { "$value": "oklch(0.71 0.16 32)" },
    "background":  { "$value": "oklch(0.985 0.014 95)" },
    "surface":     { "$value": "oklch(0.965 0.02 90)" },
    "surfaceElevated":{ "$value": "oklch(0.995 0.008 95)" },
    "border":      { "$value": "oklch(0.88 0.025 110)" },
    "text":        { "$value": "oklch(0.24 0.04 150)" },
    "textMuted":   { "$value": "oklch(0.44 0.025 150)" },
    "textSubtle":  { "$value": "oklch(0.58 0.02 150)" },
    "success":     { "$value": "oklch(0.52 0.15 150)" },
    "warning":     { "$value": "oklch(0.68 0.16 75)" },
    "danger":      { "$value": "oklch(0.55 0.20 28)" },
    "info":        { "$value": "oklch(0.52 0.13 230)" }
  },

  "colorScheme": { "$value": "light" },

  "font": {
    "heading":   { "$value": "Crimson Pro" },
    "body":      { "$value": "Inter" },
    "mono":      { "$value": "JetBrains Mono" },
    "weights":   { "$value": [400,500,600,700,800] },
    "fluidScale":{ "$value": "clamp" }
  },

  "radius":  { "sm": { "$value": "0.5rem" }, "md": { "$value": "0.875rem" }, "lg": { "$value": "1.25rem" }, "xl": { "$value": "1.75rem" }, "2xl": { "$value": "2.25rem" }, "full": { "$value": "9999px" } },
  "spacing": { "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }, "32": { "$value": "8rem" } },
  "shadow":  { "sm": { "$value": "0 1px 2px 0 oklch(0.40 0.10 90 / 0.08)" }, "md": { "$value": "0 10px 30px -12px oklch(0.40 0.10 90 / 0.22), 0 2px 8px -4px oklch(0.40 0.10 90 / 0.12)" }, "lg": { "$value": "0 24px 60px -16px oklch(0.40 0.10 90 / 0.30), 0 6px 16px -8px oklch(0.40 0.10 90 / 0.16)" }, "glow": { "$value": "0 0 48px -10px oklch(0.78 0.15 35 / 0.50)" } },
  "motion":  { "easing": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)" }, "duration": { "fast": { "$value": "160ms" }, "base": { "$value": "260ms" }, "slow": { "$value": "480ms" }, "scroll": { "$value": "1200ms" } } },
  "layout":  { "containerWide": { "$value": "80rem" }, "containerNormal": { "$value": "64rem" }, "containerProse": { "$value": "42rem" } },
  "social":  { "facebook": { "$value": "" }, "instagram": { "$value": "" }, "linkedin": { "$value": "" }, "twitter": { "$value": "" }, "youtube": { "$value": "" }, "tiktok": { "$value": "" }, "github": { "$value": "" } },

  "features": {
    "hero":         { "$value": true },
    "bento":        { "$value": true },
    "stats":        { "$value": true },
    "services":     { "$value": true },
    "process":      { "$value": true },
    "testimonials": { "$value": true },
    "logoCloud":    { "$value": true },
    "pricing":      { "$value": false },
    "faq":          { "$value": true },
    "blog":         { "$value": true },
    "team":         { "$value": true },
    "caseStudies":  { "$value": true },
    "newsletter":   { "$value": true },
    "cta":          { "$value": true }
  }
}
