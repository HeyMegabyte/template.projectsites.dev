{
  "$schema": "https://schemas.designtokens.org/2025-10",
  "$description": "Restaurant / café / bakery / bar preset — LIGHT, warm earthy terracotta on cream with an olive accent. Artisanal 'wood-fired' mood: soft radii, warm amber-tinted shadows, Playfair Display headings over Inter. Cafés & bakeries map here.",

  "business": {
    "name":          { "$value": "Northern Lights Bakery" },
    "shortName":     { "$value": "NL Bakery" },
    "tagline":       { "$value": "Fresh sourdough daily" },
    "description":   { "$value": "Neighborhood bakery and café in Anchorage, AK. Wild-yeast sourdough, laminated pastry, and single-origin coffee, baked fresh before dawn every morning." },
    "url":           { "$value": "https://nlbakery.example" },
    "businessClass": { "$value": "restaurant" },
    "email":         { "$value": "hello@nlbakery.example" },
    "phone":         { "$value": "+19075550100" },
    "address":       { "$value": "88 G Street, Anchorage, AK 99501" },
    "hours":         { "$value": "Wed–Sun 7am–3pm · Closed Mon & Tue" }
  },

  "color": {
    "brandHue":    { "$value": "45" },
    "brandChroma": { "$value": "0.15" },
    "primary":     { "$value": "oklch(0.52 0.15 45)" },
    "primaryHover":{ "$value": "oklch(0.45 0.15 45)" },
    "accent":      { "$value": "oklch(0.80 0.15 105)" },
    "accentHover": { "$value": "oklch(0.73 0.16 105)" },
    "background":  { "$value": "oklch(0.975 0.018 75)" },
    "surface":     { "$value": "oklch(0.955 0.024 70)" },
    "surfaceElevated":{ "$value": "oklch(0.99 0.012 75)" },
    "border":      { "$value": "oklch(0.88 0.03 60)" },
    "text":        { "$value": "oklch(0.26 0.04 45)" },
    "textMuted":   { "$value": "oklch(0.46 0.03 45)" },
    "textSubtle":  { "$value": "oklch(0.60 0.02 45)" },
    "success":     { "$value": "oklch(0.55 0.15 145)" },
    "warning":     { "$value": "oklch(0.70 0.16 75)" },
    "danger":      { "$value": "oklch(0.55 0.20 30)" },
    "info":        { "$value": "oklch(0.55 0.12 230)" }
  },

  "colorScheme": { "$value": "light" },

  "font": {
    "heading":   { "$value": "Playfair Display" },
    "body":      { "$value": "Inter" },
    "mono":      { "$value": "JetBrains Mono" },
    "weights":   { "$value": [400,500,600,700,800] },
    "fluidScale":{ "$value": "clamp" }
  },

  "radius":  { "sm": { "$value": "0.375rem" }, "md": { "$value": "0.75rem" }, "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.625rem" }, "2xl": { "$value": "2.25rem" }, "full": { "$value": "9999px" } },
  "spacing": { "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" }, "4": { "$value": "1rem" }, "6": { "$value": "1.5rem" }, "8": { "$value": "2rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" }, "32": { "$value": "8rem" } },
  "shadow":  { "sm": { "$value": "0 1px 2px 0 oklch(0.40 0.10 45 / 0.10)" }, "md": { "$value": "0 12px 32px -12px oklch(0.40 0.10 45 / 0.26), 0 3px 10px -5px oklch(0.40 0.10 45 / 0.14)" }, "lg": { "$value": "0 26px 64px -16px oklch(0.40 0.10 45 / 0.34), 0 8px 18px -8px oklch(0.40 0.10 45 / 0.18)" }, "glow": { "$value": "0 0 48px -10px oklch(0.80 0.15 105 / 0.55)" } },
  "motion":  { "easing": { "$value": "cubic-bezier(0.34, 1.2, 0.64, 1)" }, "duration": { "fast": { "$value": "170ms" }, "base": { "$value": "280ms" }, "slow": { "$value": "500ms" }, "scroll": { "$value": "1200ms" } } },
  "layout":  { "containerWide": { "$value": "80rem" }, "containerNormal": { "$value": "64rem" }, "containerProse": { "$value": "42rem" } },
  "social":  { "facebook": { "$value": "" }, "instagram": { "$value": "" }, "linkedin": { "$value": "" }, "twitter": { "$value": "" }, "youtube": { "$value": "" }, "tiktok": { "$value": "" }, "github": { "$value": "" } },

  "features": {
    "hero":         { "$value": true },
    "bento":        { "$value": true },
    "stats":        { "$value": false },
    "services":     { "$value": true },
    "process":      { "$value": false },
    "testimonials": { "$value": true },
    "logoCloud":    { "$value": false },
    "pricing":      { "$value": false },
    "faq":          { "$value": true },
    "blog":         { "$value": true },
    "team":         { "$value": false },
    "caseStudies":  { "$value": false },
    "newsletter":   { "$value": true },
    "cta":          { "$value": true }
  }
}
